	cd qclient\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\code\qt\perject\ChatBoxes\qclient\qclient.pro -spec win32-g++ "CONFIG+=debug" "CONFIG+=qml_debug" ) && $(MAKE) -f Makefile debug
